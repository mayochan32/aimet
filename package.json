{
  "name": "@mayo32/aimet",
  "version": "2.1.0",
  "description": "AI Metrics - collect time & token metrics from Claude Code / Codex / GitHub Copilot session logs",
  "type": "module",
  "bin": {
    "aimet": "dist/cli.js"
  },
  "files": [
    "dist",
    "integrations",
    "examples",
    "CONTRIBUTING.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --experimental-strip-types src/cli.ts",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "test:e2e:copilot-windows": "powershell -NoProfile -ExecutionPolicy Bypass -File test/e2e/copilot-windows.ps1"
  },
  "keywords": [
    "ai",
    "metrics",
    "claude-code",
    "codex",
    "copilot",
    "tokens"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
